# Copy to .env.local and adjust. Never commit .env.local.
# NEXT_PUBLIC_* values are embedded in the browser bundle: never put secrets in them.

# Base URL of the Express API, including the version prefix
NEXT_PUBLIC_API_URL=http://localhost:5000/api/v1

# Public URL of this site (used for metadata and absolute links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
