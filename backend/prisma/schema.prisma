// Prisma schema for Her Choice.
// Models, enums and relations are added in the Database module.
// Connection URL comes from prisma.config.js (DATABASE_URL).

generator client {
  // Emits plain JavaScript into node_modules/@prisma/client, so no TypeScript build step is needed
  provider = "prisma-client-js"
}

datasource db {
  provider     = "mysql"
  relationMode = "foreignKeys"
}
