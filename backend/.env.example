# Copy to .env and fill in real values. Never commit the real .env file.
# Active variables are validated at startup (src/config/env.js); the server refuses to start if any are invalid.
# Commented-out sections become active in the module noted in their heading.

# ── Server ────────────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=development
PORT=5000

# Origin of the Next.js frontend (scheme + host + port, no path).
# It is the only browser origin allowed to call the API with cookies. Must be https in production.
FRONTEND_URL=http://localhost:3000

# Number of reverse-proxy hops in front of the API (0 locally, usually 1 behind Nginx/a load balancer)
TRUST_PROXY=0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Maximum size of JSON / urlencoded request bodies
BODY_SIZE_LIMIT=100kb

# Global API rate limit per client IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Database (Prisma + MySQL) ─────────────────────────────────────────────
# mysql://USER:PASSWORD@HOST:PORT/DATABASE  (URL-encode special characters in the password, e.g. @ → %40)
DATABASE_URL=mysql://her_choice:change-me@localhost:3306/her_choice

# Use TLS for the database connection. Required in production unless MySQL runs on the same machine.
DATABASE_SSL=false

# Connection pool size and connect timeout
DB_CONNECTION_LIMIT=10
DB_CONNECT_TIMEOUT_MS=10000

# ── Authentication (Auth module) ──────────────────────────────────────────
# Generate each secret with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# JWT_ACCESS_SECRET=
# JWT_REFRESH_SECRET=
# JWT_ACCESS_EXPIRES_IN=15m
# JWT_REFRESH_EXPIRES_IN=7d
# COOKIE_DOMAIN=
# BCRYPT_SALT_ROUNDS=12

# ── Razorpay (Payments module) ────────────────────────────────────────────
# Test-mode keys from https://dashboard.razorpay.com/app/keys
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=

# ── Cloudinary (Image uploads module) ─────────────────────────────────────
# CLOUDINARY_CLOUD_NAME=
# CLOUDINARY_API_KEY=
# CLOUDINARY_API_SECRET=
# CLOUDINARY_UPLOAD_FOLDER=her-choice/products

# ── Email via SMTP / Brevo (Notifications module) ─────────────────────────
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# EMAIL_FROM="Her Choice <no-reply@example.com>"

# ── Business rules (Checkout module) ──────────────────────────────────────
# COD_ENABLED=true
# COD_MAX_ORDER_AMOUNT=10000.00
