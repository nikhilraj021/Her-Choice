# Copy to .env and adjust. Never commit the real .env file.
# Later modules (database, auth, payments, uploads, email) will add their own variables here.

# development | production | test
NODE_ENV=development

PORT=5000

# Comma-separated list of browser origins allowed to call the API with cookies
CORS_ORIGINS=http://localhost:3000

# Number of reverse-proxy hops in front of the API (0 locally, usually 1 behind Nginx/a load balancer).
# Required for correct client IPs in rate limiting and secure cookies.
TRUST_PROXY=0

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Maximum size of JSON / urlencoded request bodies
BODY_SIZE_LIMIT=100kb

# Global API rate limit per client IP
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
